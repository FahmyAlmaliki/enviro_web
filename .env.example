# InfluxDB — WAJIB diisi
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=ganti-token-ini
INFLUX_ORG=ub
INFLUX_BUCKET=air_quality
INFLUX_USER=admin
INFLUX_PASSWORD=ganti-password-ini

# Keamanan endpoint ingest — WAJIB diisi
INGEST_API_KEY=ganti-api-key-ini

# Sub-path saat dipasang di reverse proxy. Kosongkan bila di root domain.
NEXT_PUBLIC_BASE_PATH=/enviro
NEXT_PUBLIC_APP_NAME=Enviro Monitor

# Lokasi penyimpanan ambang batas & layout TV di dalam container
DATA_DIR=/app/data
